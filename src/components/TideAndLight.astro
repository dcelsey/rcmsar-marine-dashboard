---
import type { StationConfig } from '../lib/stations';
/* `showSun` lets a view take the tide card without the sun card. The kiosk is a
   ready-room glance surface where twilight times are reference material, not something
   read before a callout — it opts out. */
interface Props { station: StationConfig; showSun?: boolean }
const { station, showSun = true } = Astro.props;
const { labels } = station;
---
<h2 class="section">Tide &amp; light</h2>
<div class="grid g3 tide-sun">
  <div class="card tide-card">
    <h3>{labels.tideCardHeading} <span class="r" id="tide-r"></span></h3>
    <div id="tide-chart"></div>
    <table id="tide-table" style="margin-top:10px">
      <thead><tr><th>Next tides</th><th class="num">Height</th><th class="num">Time</th></tr></thead>
      <tbody><tr><td colspan="3" class="skel">Loading…</td></tr></tbody>
    </table>
    <p class="tiny muted" style="margin:8px 2px 0">Metres, chart datum. Predictions (astronomical) from DFO IWLS.</p>
  </div>
  {showSun && (
    <div class="card sun-card">
      <h3>Sun &amp; twilight</h3>
      <table id="sun-table"><tbody><tr><td class="skel">Loading…</td></tr></tbody></table>
      <p class="tiny muted" style="margin:8px 2px 0">{labels.sunFootnote}</p>
    </div>
  )}
</div>
