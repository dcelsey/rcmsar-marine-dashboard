---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Warnbar from '../../components/Warnbar.astro';
import Glance from '../../components/Glance.astro';
import WindByLocation from '../../components/WindByLocation.astro';
import MarineCurrents from '../../components/MarineCurrents.astro';
import TideAndLight from '../../components/TideAndLight.astro';
import HourlyStrip from '../../components/HourlyStrip.astro';
import { STATIONS, getStation } from '../../lib/stations';
import '../../styles/ultrawide.css';
import '../../styles/kiosk.css';

export const getStaticPaths = () =>
  Object.keys(STATIONS).map(slug => ({ params: { station: slug } }));

const station = getStation(Astro.params.station!);
---
<Base station={station} bodyClass="ultrawide">
  <Header station={station} variant="kiosk" />
  <div class="wrap">
    <Warnbar />
    <Glance station={station} />
    <WindByLocation />
    {station.currents?.show !== false && <MarineCurrents station={station} />}
    {/* No tide station means the card can only ever render "no data" — on a glance
        surface an empty card is worse than no card, so inland units drop it and give
        the width to wind. The Tide summary tile still says "Freshwater — no tide",
        which is where that fact belongs. */}
    {station.tideStationId && <TideAndLight station={station} showSun={false} />}
    <HourlyStrip />
  </div>
</Base>

<script>
  import '../../scripts/refresh';
</script>
